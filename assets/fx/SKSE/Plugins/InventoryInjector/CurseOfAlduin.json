{
  "$schema": "https://raw.githubusercontent.com/Exit-9B/InventoryInjector/main/docs/InventoryInjector.schema.json",
  "rules": [
    {
      "match": {
        "formType": "MiscItem",
        "formId": {
          "anyOf": [
            "Paragliding.esp|802"
          ]
        }
      },
      "assign": {
        "subTypeDisplay": "Dragon",
        "iconSource": "skyui/icons_item_psychosteve.swf",
        "iconLabel": "misc_dragonclaw",
        "iconColor": "#e0b060"
      }
    },
    {
      "match": {
        "formType": "Spell",
        "formId": {
          "anyOf": [
            "mihailesobonecolossus.esp|822",
            "Apocalypse - Magic of Skyrim.esp|44264"
          ]
        }
      },
      "assign": {
        "iconColor": "#ffc94a",
        "infoSchoolName": "Legendary"
      }
    }
  ]
}
